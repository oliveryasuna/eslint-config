{
  "name": "@oliveryasuna/eslint-config",
  "version": "2.2.2",
  "license": "MIT",
  "homepage": "https://github.com/oliveryasuna/eslint-config",
  "author": "Oliver Yasuna",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliveryasuna/eslint-config.git"
  },
  "bugs": "https://github.com/oliveryasuna/eslint-config/issues",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "RULES.md"
  ],
  "scripts": {
    "build": "bun run gen && tsdown",
    "check:bun": "bun run ./check-bun-version.ts",
    "format:pkg": "syncpack format",
    "gen": "bun run ./scripts/generate.ts",
    "gen:check": "bun run ./scripts/verify-generated.ts",
    "lint": "eslint",
    "prepack": "bun run build",
    "prepare": "bun run check:bun && bun run format:pkg && husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.5.0",
    "@eslint/core": "1.2.1",
    "@eslint/js": "9.39.2",
    "@eslint/markdown": "8.0.3",
    "@stylistic/eslint-plugin": "5.9.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/utils": "8.56.1",
    "@vitest/eslint-plugin": "1.6.26",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-toml": "1.5.0",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-yml": "3.8.1",
    "globals": "16.5.0",
    "jsonc-eslint-parser": "2.4.2",
    "toml-eslint-parser": "1.0.3",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.18.3",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.3.14",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-typegen": "2.3.0",
    "husky": "9.1.7",
    "jiti": "2.4.0",
    "lint-staged": "17.1.0",
    "secretlint": "13.0.2",
    "syncpack": "15.3.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "eslint": "^9.10.0 || ^10.0.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-jest": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react-compiler": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
